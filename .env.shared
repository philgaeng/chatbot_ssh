# ─────────────────────────────────────────────────────────────────────────────
# .env.shared — the PLAINTEXT half of this repo's environment. COMMITTED.
#
# ⚠ NEVER put a credential in this file. It is committed in the clear.
#   Secrets live in `secrets.enc.env` (SOPS + age). See docs/deployment/13_security.md §5.
#
# This file is a SOURCE, not something any service reads. Services read `env.local`,
# which is a BUILD ARTEFACT generated from this file plus the decrypted secrets:
#
#     .env.shared  +  secrets.enc.env  ──(make env-local)──>  env.local  (gitignored, 0600)
#
# `#@secret NAME` marks where a secret is spliced back in, so this file keeps the
# original ordering, section headers and comments — that is the whole point of the
# plaintext half (§5.2: "comments and structure live in .env, not the encrypted file").
#
# Adding a variable:
#   • non-secret → add it here, in the right section
#   • secret     → add `#@secret NAME` here AND `sops secrets.enc.env` to set the value.
#                  `make env-local` fails loudly if the two halves disagree.
#
# Why not named `.env`? `.env` is gitignored on purpose (CL-03, .gitignore:29) so that
# the universal "secrets go in .env" reflex cannot commit a secret here. Un-ignoring it
# to satisfy a filename would delete that safety net.
# ─────────────────────────────────────────────────────────────────────────────
#@shared-header-end

# ── Database ─────────────────────────────────────────────────────────────────
# The compose files interpolate POSTGRES_USER / POSTGRES_DB / POSTGRES_PASSWORD from
# here with ${VAR:?}, so an unset value stops the stack loudly instead of falling back
# to a default. Restoring a `:-` default here would silently recreate the defect below.
#
# ⚠ Only USER / DB / PASSWORD are credentials. POSTGRES_HOST and POSTGRES_PORT are
# overridden by every compose service to the container topology (db:5432); host-side
# tools reach the same database at localhost:${POSTGRES_HOST_PORT:-5433}. Neither is a
# secret, and neither is read from this file by a container.
#
# ⚠ The role and database names below are what the deployed volumes actually contain.
# This file said `nepal_grievance_admin` / `grievance_db` for months while every database
# on every host answered to `user` / `app_db`, because eleven compose literals overrode
# it and nothing read it. Renaming the role and the database to match the documentation
# is a separate coordinated migration across three hosts — see
# docs/sprints/followups/db-password-hardcoded-in-compose.md. Do not "correct" these two
# lines without doing that migration first; they would become fiction again.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=user
#@secret POSTGRES_PASSWORD

# ⚠ The ops monitor connects as the SCOPED role `ops_app`, not as POSTGRES_USER, and it needs
# its OWN password. Until 2026-08-24 this variable did not exist, so ops/config.py fell back to
# POSTGRES_PASSWORD (`ops_db_password or postgres_password`) and authenticated as one role using
# another role's credential. The 2026-08-21 POSTGRES_PASSWORD rotation did not touch `ops_app`,
# so ops went silently blind for three days — 253 auth failures, every report row `n/a`.
# Rotating POSTGRES_PASSWORD must no longer be able to break monitoring: keep these separate.
# See docs/sprints/2026-08-llm/followups/ops-cannot-authenticate-since-rotation.md
#@secret OPS_DB_PASSWORD

# Redis Configuration (matching launch_servers.sh)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
#@secret REDIS_PASSWORD


# Service endpoints inside Docker network
FLASK_URL=http://backend:5001
UPLOAD_PROTOCOL=http
FILE_UPLOAD_PATH=/upload-files
FILE_UPLOAD_MAX_SIZE_MB=10
PORT_UPLOAD=:5001

# Runtime behavior
LOG_LEVEL=INFO

# Project Configuration (local paths)
BASE_DIR=/home/philg/projects/nepal_chatbot
LOG_DIR=/home/philg/projects/nepal_chatbot/logs
VENV_DIR=/home/philg/projects/nepal_chatbot/rasa-env-21
UPLOAD_DIR=/home/philg/projects/nepal_chatbot/uploads
SCRIPT_DIR=/home/philg/projects/nepal_chatbot/scripts
PROJECT_ROOT=/home/philg/projects/nepal_chatbot

# Additional environment variables for consistency with remote .env
PYTHONPATH=/home/philg/projects/nepal_chatbot
FLASK_APP=actions_server/app.py
FLASK_ENV=development

# API Keys and Tokens (matching remote .env)
#@secret OPENAI_API_KEY
##Huggingface
#@secret HG_USERNAME
#@secret HG_TOKEN

# Email Configuration
# ⚠ Reconciled with AWS staging 2026-08-24 — staging's mail config is the correct one and
# now overwrites what was here (server, username, password). The previous values were a
# Gmail relay that staging had already moved off. See 18_sops_migration_handover.md §5a.
SMTP_SERVER=mail.infomaniak.com
SMTP_PORT=587
#@secret SMTP_USERNAME
#@secret SMTP_PASSWORD
# The envelope From. Same value as SMTP_USERNAME, so it carries the same class (§5.2's rule:
# a username paired with a credential for the same service is secret-class).
#@secret SMTP_FROM
SMTP_FROM_DISPLAY=GRM
SES_VERIFIED_EMAIL=philgaeng@project.com.ph
ADMIN_EMAIL=philgaeng@pm.me
# Recap-mail recipients. Comma-separated; overrides ADMIN_EMAIL when set. Empty means
# nobody is mailed — the right default for a fresh clone of a public repository.
ADMIN_EMAILS=

# ── SMS ──────────────────────────────────────────────────────────────────────
# Government of Nepal gateway — the PRODUCTION complainant-notification path. AWS SNS
# (below) is only the international/dev fallback.
#
# ⚠ SMS_ENABLED is deliberately NOT here. It is per-host: staging runs with it true, and a
# shared `true` would start sending real SMS from any developer's stack. Absent, the code
# falls back to backend/config/constants.SMS_ENABLED (sms_config.py:58-63). Set it in
# env.local.extra on hosts that should send.
SMS_PROVIDER=doit
DOIT_SMS_BASE_URL=https://sms.doit.gov.np
#@secret DOIT_SMS_BEARER_TOKEN

# AWS Configuration
AWS_REGION=ap-southeast-1
PINPOINT_APPLICATION_ID=d66d14c00df04c5c88a1fa8f8fbeb809
#@secret AWS_ACCESS_KEY_ID
#@secret AWS_SECRET_ACCESS_KEY

#SQL ENCRYPTION
#@secret DB_ENCRYPTION_KEY

#CLASSIFICATION
ENABLE_CELERY_CLASSIFICATION=true

# Ticketing API (chatbot → ticketing webhook)
TICKETING_API_URL=http://ticketing_api:5002
#@secret TICKETING_SECRET_KEY

# Canonical env + auth mode (CL-03). The local dev stack runs bypass so the
# ticketing_api (:5002) + backend boot without real Keycloak/API-key config.
# Production hosts MUST leave these at the defaults (APP_ENV=production,
# AUTH_MODE=keycloak) and configure KEYCLOAK_ISSUER + TICKETING_SECRET_KEY, or the
# services refuse to start. Bypass is honoured only when APP_ENV=dev.
APP_ENV=dev
AUTH_MODE=bypass

# ── Keycloak — the host-INDEPENDENT half only ────────────────────────────────
# Client ids and the local admin port are the same everywhere; the realm's own URLs are not.
# ⚠ KEYCLOAK_ISSUER, KC_HOSTNAME_URL, KC_HTTP_RELATIVE_PATH, KEYCLOAK_ADMIN_URL,
# KEYCLOAK_JWKS_URL, KEYCLOAK_INVITE_REDIRECT_URI, NEXT_PUBLIC_OIDC_ISSUER and
# NEXT_PUBLIC_BYPASS_AUTH all encode the deployment's own hostname and auth mode, so they
# CANNOT live in a file every host shares — putting staging's `nepal-gms-chatbot.facets-ai.com`
# here would break local and prod. They belong in env.local.extra per host.
# See 18_sops_migration_handover.md §5a Hazard 2.
KEYCLOAK_CLIENT_ID=ticketing-api
KEYCLOAK_INVITE_CLIENT_ID=ticketing-ui
NEXT_PUBLIC_OIDC_CLIENT_ID=ticketing-ui
KEYCLOAK_HOST_PORT=18080
#@secret KEYCLOAK_ADMIN_PASSWORD
#@secret KEYCLOAK_CLIENT_SECRET
#@secret KEYCLOAK_WEBHOOK_SECRET

# ─────────────────────────────────────────────────────────────────────────────
# Nepal Chatbot / GRM Ticketing — environment template
#
# Copy to `env.local` (gitignored) and fill in. Every service (chatbot backend,
# ticketing API, ops monitor, Celery workers, Keycloak) reads this via
# `env_file: env.local` / `docker compose --env-file env.local`.
#
# ONE canonical name per concept (CL-03):
#   APP_ENV        dev | staging | production   (replaces TICKETING_ENV/BACKEND_ENV/ENVIRONMENT)
#   AUTH_MODE      keycloak | bypass            (bypass honoured ONLY when APP_ENV=dev)
#   KEYCLOAK_ISSUER  single browser-facing issuer (frontend NEXT_PUBLIC_OIDC_ISSUER is derived)
#
# Fail-closed (HR-01): unless APP_ENV=dev AND AUTH_MODE=bypass, the ticketing API +
# backend refuse to start without KEYCLOAK_ISSUER + TICKETING_SECRET_KEY. Production
# can never bypass.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment + auth mode ──────────────────────────────────────────────────
# Local dev stack: APP_ENV=dev AUTH_MODE=bypass
# Staging/prod:     APP_ENV=production AUTH_MODE=keycloak (+ KEYCLOAK_ISSUER below)
APP_ENV=dev
AUTH_MODE=bypass

# ── Database (Postgres — shared app_db; schemas: public.* / ticketing.* / ops.*) ──
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Host port the compose `db` service publishes for host-side psql / pytest.
POSTGRES_HOST_PORT=5433

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Leave empty for plain local Redis; set to enable requirepass (prod).
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Ticketing API ────────────────────────────────────────────────────────────
TICKETING_PORT=5002
# Shared secret for the chatbot → ticketing webhook (x-api-key) and ticketing →
# backend calls. REQUIRED unless APP_ENV=dev AUTH_MODE=bypass.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TICKETING_SECRET_KEY=
# Chatbot action server → ticketing intake target (the single consolidated API).
TICKETING_API_URL=http://ticketing_api:5002
BACKEND_GRIEVANCE_BASE_URL=http://backend:5001
ORCHESTRATOR_BASE_URL=http://orchestrator:8000
# Public base for the complainant closure page (no trailing slash).
TICKETING_PUBLIC_BASE_URL=https://nepal-gms-chatbot.facets-ai.com
# Webchat URL embedded in QR codes.
CHATBOT_WEBCHAT_URL=https://grm.facets-ai.com/chat
# CORS allowlist (comma-separated). Empty → "*" without credentials (dev). Set in prod.
CORS_ALLOWED_ORIGINS=
# Same key as chatbot backend — decrypts vault fields for the reveal broker.
DB_ENCRYPTION_KEY=
# ── LLM: provider, models, deadlines, structured output ──────────────────────
# Declared in ONE place — backend/config/llm_config.py — which BOTH LLM surfaces read
# (chatbot intake and ticketing case analysis). Changing provider is an environment change,
# not a code change: that is the DPG indicator-4 claim, and a test proves one LLM_BASE_URL
# change moves both surfaces.
#
# Two ready-made configurations sit beside this file: `.env.openai` (today's default) and
# `.env.open` (open-weights via the Hugging Face router). Copy the block you want.
#
# ⚠ This block is PINNED against llm_config.declared_env_vars() by
#    tests/backend/test_llm_config_pins.py — a variable added to the code and not documented
#    here, or documented here and no longer read, fails the build. Do not hand-maintain it
#    against memory; read the registry.

# The chat/completions endpoint. Default is OpenAI's own.
#   open (T1):     https://router.huggingface.co/v1
#   self-hosted:   http://<host>:8000/v1   (vLLM — designed, parked)
LLM_BASE_URL=https://api.openai.com/v1
# Leave empty and the client is not built at all — every call site then takes its own
# documented fallback rather than 401-ing per request.
LLM_API_KEY=
# Seconds. Default is the SDK's own; per-task overrides below.
LLM_TIMEOUT=600.0
LLM_MAX_RETRIES=2
# The endpoint's structured-output CEILING: json_schema | json_object | prompt.
# Per-task capability (STRUCTURED_* below) clamps it further; the effective mode is the
# weaker of the two, and it degrades — never upward.
LLM_STRUCTURED_OUTPUT=json_schema

# The transcription endpoint. Empty → falls back to the chat endpoint, field by field.
# ASR often runs elsewhere (different provider, port or machine) and is much slower.
ASR_BASE_URL=
ASR_API_KEY=
# 0 → use LLM_TIMEOUT. Set this well above it for self-hosted Whisper.
ASR_TIMEOUT=0

# ── Models, per task ─────────────────────────────────────────────────────────
# Defaults are today's models, deliberately: an open base URL with these model ids serves
# nothing, so the open flip is one edit per line here once DPG-23 has named the models.
MODEL_CLASSIFY=gpt-5-nano
MODEL_EXTRACT=gpt-5-nano
MODEL_TRANSLATE=gpt-5-nano
MODEL_DETECT=gpt-5-nano
MODEL_ASR=whisper-1
# Empty → follows MODEL_TRANSLATE. Set only when the two surfaces must differ.
MODEL_TICKET_TRANSLATE=
MODEL_TICKET_FINDINGS=gpt-5-nano
# SEAH cases get the more careful model — a deliberate cost/quality split, kept as two keys.
MODEL_TICKET_FINDINGS_SEAH=gpt-5-nano

# ── Per-task deadlines (seconds; 0 → LLM_TIMEOUT) ────────────────────────────
# ⚠ Classification measured at 14–20.5 s against a 20 s retrieve-step poll deadline
#    (PROGRESS D-30). This timeout is the model's budget, not that poll's.
TIMEOUT_CLASSIFY=120.0
TIMEOUT_TICKET=30.0

# ── Meaningful input (DPG-19) ────────────────────────────────────────────────
# Below this many non-whitespace characters the model is NOT called: there is nothing to
# summarise, the grievance is marked as skipped, and that is not an error.
# ⚠ Not the same amount of information in every script — 25 Devanagari characters is a short
# sentence, 25 English ones about four words.
MIN_CLASSIFY_CHARS=25

# ── Per-task structured-output capability — OVERRIDES ONLY ───────────────────
# ⚠ Capability belongs to the (endpoint, MODEL) pair, not the endpoint. Measured 2026-08-18:
#   gpt-5-nano ✅ schema · gpt-4o-mini ✅ schema · gpt-3.5-turbo 400 on schema ·
#   gpt-4      400 on BOTH — no JSON mode at all.
# Leave these EMPTY: the model's profile decides, so changing a MODEL_* above lifts or lowers the
# rung automatically. Set one only to correct a profile we have wrong for some provider.
STRUCTURED_CLASSIFY=
STRUCTURED_EXTRACT=
STRUCTURED_TRANSLATE=
STRUCTURED_DETECT=
STRUCTURED_TICKET_FINDINGS=

# Deprecated, still honoured (one warning each, then the new name wins):
#   OPENAI_API_KEY                 → LLM_API_KEY / ASR_API_KEY
#   OPENAI_CLASSIFICATION_TIMEOUT  → TIMEOUT_CLASSIFY

# ── Keycloak (used when AUTH_MODE=keycloak; ignored under dev bypass) ─────────
# Browser-facing issuer — MUST match tokens' `iss` claim (scheme + path).
#   Pattern A (local direct port):  http://localhost:18080/realms/grm
#   Pattern B (single host, nginx): https://grm-chatbot.dor.gov.np/keycloak/realms/grm
KEYCLOAK_ISSUER=
# Docker-internal JWKS fetch URL (backend can't reach the browser host port).
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/grm/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=ticketing-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_ADMIN_PASSWORD=admin
# Shared secret for POST /api/v1/webhooks/keycloak (Keycloak HTTP event listener).
KEYCLOAK_WEBHOOK_SECRET=
KEYCLOAK_INVITE_CLIENT_ID=ticketing-ui
KEYCLOAK_INVITE_REDIRECT_URI=http://localhost:3001/login
# Keycloak container hostname/proxy config (see docs/deployment/16_auth_keycloak.md §1).
KC_HOSTNAME_URL=http://localhost:18080
KC_HTTP_RELATIVE_PATH=/
KEYCLOAK_HOST_PORT=18080

# ── Frontend build args (Docker derives these from AUTH_MODE / KEYCLOAK_ISSUER) ──
# Only needed for a bare `npm run dev` outside Docker; the grm_ui image sets them.
#   NEXT_PUBLIC_AUTH_MODE   = AUTH_MODE
#   NEXT_PUBLIC_OIDC_ISSUER = KEYCLOAK_ISSUER
NEXT_PUBLIC_REDIRECT_SIGN_IN=
NEXT_PUBLIC_REDIRECT_SIGN_OUT=

# ── SMTP (Keycloak invite mail + Messaging API) ──────────────────────────────
# Note: a literal `$` in a password must be doubled (`$$`) in env.local (Compose escaping).
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_DISPLAY=GRM Ticketing

# ── Messaging (SMS via AWS SNS — international; used for complainant fallback) ──
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MESSAGING_API_KEY=

# ── Ops monitor (platform health/backup/security/report; ops.* schema) ───────
# Scoped least-privilege role created by the ops001 migration.
OPS_DB_USER=ops_app
OPS_DB_PASSWORD=
MESSAGING_API_URL=http://backend:5001
HEALTH_ALERT_EMAIL=
DAILY_REPORT_EMAIL=
DAILY_REPORT_TZ=Asia/Kathmandu
# External dead-man's switch (healthchecks.io ping URL).
HEARTBEAT_URL=

# ── Production deploy (Makefile prod-* targets; VPN + password SSH) ───────────
PROD_SERVER_USER=
PROD_HOST=103.175.193.226
# PROD_REMOTE_DIR=/home/${PROD_SERVER_USER}/nepal_chatbot
# PROD_SSH_KEY=/home/you/.ssh/nepal_gms_prod

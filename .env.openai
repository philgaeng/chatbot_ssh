# ─────────────────────────────────────────────────────────────────────────────
# .env.openai — the PROPRIETARY configuration (today's default)
#
# One of two side-by-side configurations that differ ONLY in these values. Nothing else
# changes: no code, no image, no compose file. That is the DPG indicator-4 claim, and
# `.env.open` is the same file pointed somewhere else.
#
# ⚠ SECRETS ARE EMPTY HERE ON PURPOSE. This file is tracked. Real values live in `env.local`
#    (gitignored) and in GitHub secrets. Never fill a key in and commit it.
#
# Usage:  copy the block below into `env.local`, set LLM_API_KEY, rebuild nothing.
#
# ⚠ Honest note: these are the models the system runs today. They are proprietary, they are
#    served from outside Nepal, and the grievance text reaches them unredacted until Sprint 3
#    lands. See docs/dpg/privacy-assessment.md §2.2 legs L4 and L5.
# ─────────────────────────────────────────────────────────────────────────────

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT=600.0
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUT=json_schema

ASR_BASE_URL=
ASR_API_KEY=
ASR_TIMEOUT=0

MODEL_CLASSIFY=gpt-5-nano
MODEL_EXTRACT=gpt-5-nano
MODEL_TRANSLATE=gpt-5-nano
MODEL_DETECT=gpt-5-nano
MODEL_ASR=whisper-1
MODEL_TICKET_TRANSLATE=
MODEL_TICKET_FINDINGS=gpt-5-nano
MODEL_TICKET_FINDINGS_SEAH=gpt-5-nano

# The first attempt gets the short deadline because a person is waiting on it; retries get
# TIMEOUT_CLASSIFY, because nobody is (DPG-15b).
TIMEOUT_CLASSIFY_INTERACTIVE=30.0
TIMEOUT_CLASSIFY=120.0
# How long the conversation waits for the classification before carrying on without it.
# The grievance is already filed by then, and the result reaches the officer either way.
CLASSIFICATION_WAIT_SECONDS=30.0
TIMEOUT_TICKET=30.0

# Below this many non-whitespace characters, no model is called (DPG-19).
MIN_CLASSIFY_CHARS=25

# Measured per model, 2026-08-18 — gpt-3.5-turbo rejects json_schema; gpt-4 rejects both.
STRUCTURED_CLASSIFY=json_schema
STRUCTURED_EXTRACT=json_object
STRUCTURED_TRANSLATE=prompt
STRUCTURED_DETECT=json_object
STRUCTURED_TICKET_FINDINGS=json_schema
